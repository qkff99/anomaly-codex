<!-- Tâches, missions -->
<string id="st_dyn_news_gossip_task_1">
<text>On dirait que le vieux %s cherche des stalkers pour bosser.</text>
</string>
<string id="st_dyn_news_gossip_task_2">
<text>Avertissement, %s a du nouveau boulot à proposer.</text>
