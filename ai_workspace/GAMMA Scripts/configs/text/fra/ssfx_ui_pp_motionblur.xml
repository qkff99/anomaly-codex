<!-- Bloom Title -->
<string id="ui_mcm_ssfx_module_motionblur_title">
<text>Motion Blur - Réglages</text>
</string>

<!-- Bloom Settings -->
<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm">
<text>Qualité</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm_desc">
<text>Définit le nombre d'échantillons utilisés pour créer l'effet de flou de mouvement. [4 - 6 - 8 - 12]</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm">
<text>Intensité Générale</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm_desc">
<text>Règle l'intensité de l'effet de flou de mouvement. Mettre à 0 pour désactiver l'effet.</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm">
<text>Intensité Flou Caméra</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm_desc">
<text>Permet d'ajuster ou de désactiver totalement le flou de mouvement causé par les déplacements de la caméra.</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm">
<text>HUD seulement</text>
</string>

<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm_desc">
<text>Applique le flou de mouvement uniquement aux éléments du HUD (mains, armes, etc.).</text>
</string>

