	<string id="ui_mcm_drx_da_anomaly_zone_spawn_chance">
		<text>Chance d'apparition d'anomalies</text>
	</string>
	<string id="ui_mcm_drx_da_anomaly_zone_spawn_chance_desc">
		<text>Probabilité qu'un terrain intelligent prédéfini génère une zone d'anomalie</text>
	</string>

	<string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_max">
		<text>Rayon de la zone d'anomalie</text>
	</string>
	<string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_max_desc">
		<text>Distance maximale autorisée depuis le centre du terrain intelligent pour la zone d'anomalie</text>
	</string>

	<string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_min">
		<text>Distance minimale entre anomalies</text>
	</string>
	<string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_min_desc">
		<text>Définit la distance minimale entre les anomalies d'une zone. Les valeurs négatives permettront le chevauchement des anomalies</text>
	</string>

	<string id="ui_mcm_drx_da_anomaly_amount_modifier">
		<text>Modificateur de quantité d'anomalies</text>
	</string>
	<string id="ui_mcm_drx_da_anomaly_amount_modifier_desc">
		<text>Modifie le nombre d'anomalies que chaque zone peut contenir</text>
	</string>

	<string id="ui_mcm_drx_da_max_artefacts_per_zone">
		<text>Artefacts maximum par zone</text>
	</string>
	<string id="ui_mcm_drx_da_max_artefacts_per_zone_desc">
		<text>Définit le nombre maximum d'artefacts pouvant apparaître dans une zone d'anomalie</text>
	</string>

	<string id="ui_mcm_drx_da_artefacts_spawn_chance">
		<text>Probabilité d'apparition d'artefacts</text>
	</string>
	<string id="ui_mcm_drx_da_artefacts_spawn_chance_desc">
		<text>Chaque artefact du nombre maximal défini aura cette probabilité d'apparaître</text>
	</string>

	<string id="ui_mcm_drx_da_random_artefact_spawn_chance">
		<text>Chance d'artefact aléatoire</text>
	</string>
	<string id="ui_mcm_drx_da_random_artefact_spawn_chance_desc">
		<text>Les artefacts disponibles dépendent du niveau. Les emplacements au sud génèrent uniquement des artefacts faibles, tandis que les souterrains et le nord peuvent générer des artefacts puissants. Ce paramètre définit la probabilité qu'une zone d'anomalie puisse générer n'importe quel artefact, y compris les uniques</text>
	</string>

	<string id="ui_mcm_drx_da_gravitational_shake_modifier">
		<text>Modificateur de secousse gravitationnelle</text>
	</string>
	<string id="ui_mcm_drx_da_gravitational_shake_modifier_desc">
		<text>Modificateur de l'intensité des secousses d'écran près des anomalies gravitationnelles</text>
	</string>

	<string id="ui_mcm_drx_da_electric_field_modifier">
		<text>Modificateur de champ électrique</text>
	</string>
	<string id="ui_mcm_drx_da_electric_field_modifier_desc">
		<text>Modificateur des dégâts des champs électriques. N'affecte pas les dysfonctionnements électroniques</text>
	</string>

	<string id="ui_mcm_drx_da_enable_anomalies_behaviour">
		<text>Activer le comportement dynamique des anomalies</text>
	</string>
	<string id="ui_mcm_drx_da_enable_anomalies_behaviour_desc">
		<text>Définit si les anomalies dynamiques ont un comportement spécial et peuvent apparaître/disparaître dans la zone</text>
	</string>

	<string id="ui_mcm_drx_da_save_after_cleanup">
		<text>Sauver la partie après suppression des anomalies</text>
	</string>
	<string id="ui_mcm_drx_da_save_after_cleanup_desc">
		<text>Sauve la partie après une émission ou tempête psi lors de la suppression d'anomalies dynamiques du niveau</text>
	</string>

	<string id="ui_mcm_drx_da_disable_new_anomalies">
		<text>Désactiver les nouvelles anomalies</text>
	</string>
	<string id="ui_mcm_drx_da_disable_new_anomalies_desc">
		<text>Désactive l'apparition de nouveaux types d'anomalies. Cette option prend effet après la prochaine émission, tempête psi ou lors d'une nouvelle partie</text>
	</string>

	<string id="ui_mcm_drx_da_choose_help">
		<text>
			Ci-dessous, vous pouvez activer sélectivement
			\nles nouveaux types d'anomalies à générer dans le jeu</text>
	</string>

