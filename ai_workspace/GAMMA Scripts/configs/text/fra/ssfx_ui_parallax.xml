<!-- Button -->
<string id="ui_mcm_ssfx_module_parallax">
<text>Parallax</text>
</string>

<!-- Parallax Settings -->
<string id="ui_mcm_ssfx_module_parallax_title">
<text>Réglages Terrain</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_quality_mcm">
<text>Qualité Parallax</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_quality_mcm_desc">
<text>Définit la qualité visuelle de l'effet. Un réglage élevé augmente le nombre d'échantillons pour lisser le résultat.</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_refine_mcm">
<text>Raffinement Parallax</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_refine_mcm_desc">
<text>Ajoute une phase de raffinement pour améliorer l'effet parallax. Activez/désactivez pour gagner en qualité visuelle ou en performances.</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_range_mcm">
<text>Distance Parallax</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_range_mcm_desc">
<text>Définit la distance maximale de rendu de l'effet parallax.</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_height_mcm">
<text>Hauteur Parallax</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_height_mcm_desc">
<text>Ajustez ici la hauteur maximale de l'effet parallax.</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_ao_mcm">
<text>AO Parallax</text>
</string>

<string id="ui_mcm_ssfx_module_parallax_ao_mcm_desc">
<text>Définit la quantité d'occlusion ambiante supplémentaire appliquée aux surfaces en parallax.</text>
</string>

