<!-- Médecine -->
	<string id="st_player_skills_hint_medicine">
		<text>Confère une amélioration temporaire de la santé et de la restauration contre la radiation selon l'objet médical utilisé.\n \nLes niveaux s'obtiennent en utilisant des médicaments et drogues.\n \n</text>
	</string>
	<string id="st_skills_stats_restore_boost_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Restauration reçue en bonus : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_restore_boost_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Restauration perdue en bonus : %c[d_red]$stat%</text>
    </string>
<!-- Folie -->
	<string id="st_player_skills_hint_insanity">
		<text>Tu perds la raison... mais tu gagnes de la régén psy et de la résistance aux dégâts psy.\nBonus psy regen doublé en jouant d'un instrument.\n \nLes niveaux s'obtiennent en subissant des dégâts psy et en jouant d'un instrument en combat.\n \n</text>
	</string>
    <string id="st_skills_stats_psy_regen_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Régénération de vie psy augmentée de : %c[d_green]$stat%/sec</text>
    </string>
    <string id="st_skills_stats_psy_hit_resistance_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Dégâts psy reçus réduits de : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_psy_hit_resistance_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Dégâts psy reçus augmentés de : %c[d_red]$stat%</text>
    </string>
<!-- Bricolage -->
	<string id="st_player_skills_hint_tinkering">
		<text>Confère une chance de ne pas consommer l'usage du kit de réparation.\n \nLes niveaux s'obtiennent en réparant de l'équipement avec les kits de réparation.\n \n</text>
	</string>
	<string id="st_skills_stats_refund_chance_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Chance d'usage gratuit du kit de réparation : %c[d_green]$stat%</text>
    </string>
<!-- Négoce -->
	<string id="st_player_skills_hint_bartering">
		<text>Permet d'obtenir de meilleurs prix à l'échange et plus d'argent pour les tâches.\n \nLes niveaux s'obtiennent en vendant des objets et en accomplissant des tâches.\n \n</text>
	</string>
	<string id="st_skills_stats_discount_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Prix des marchands baissés de : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_discount_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Prix des marchands haussés de : %c[d_red]$stat%</text>
    </string>
	<string id="st_skills_stats_sell_bonus_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Valeur de vente augmentée de : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_sell_bonus_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Valeur de vente diminuée de : %c[d_red]$stat%</text>
    </string>
    <string id="st_skills_stats_task_bonus_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Récompense d'argent de tâche augmentée de : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_task_bonus_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Récompense d'argent de tâche diminuée de : %c[d_red]$stat%</text>
    </string>
<!-- Magasinage -->
	<string id="st_player_skills_hint_magloading">
		<text>Permet de charger/décharger les chargeurs plus vite.\n \nLes niveaux s'obtiennent en chargeant et déchargeant des chargeurs.\n(Le niveau maximum dépend de la force et de l'endurance)\n \n</text>
	</string>
	<string id="st_skills_stats_loadspeed_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Vitesse de chargement de mag + : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_loadspeed_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Vitesse de chargement de mag - : %c[d_red]$stat%</text>
    </string>
<!-- Crochetage -->
	<string id="st_player_skills_hint_lockpicking">
		<text>Confère : difficulté des coffres réduite.\n \nLes niveaux s'obtiennent en ouvrant des coffres.\n(Utiliser la clé passe-partout ne donne pas d'XP)\n \n</text>
	</string>
	<string id="st_skills_stats_lockpick_diff_reduc_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Difficulté du coffre réduite de : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_lockpick_diff_reduc_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Difficulté du coffre augmentée de : %c[d_red]$stat%</text>
    </string>
<!-- Rechargement -->
	<string id="st_player_skills_hint_reloading">
		<text>Permet de recharger plus vite et de sortir/ranger l'arme plus rapidement.\n \nLes niveaux s'obtiennent en utilisant régulièrement les armes.\n(Le niveau maximum dépend de l'endurance et de la survie)\n \n</text>
	</string>
	<string id="st_skills_stats_reload_speed_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Vitesse de rechargement + : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_reload_speed_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Vitesse de rechargement - : %c[d_red]$stat%</text>
    </string>
	<string id="st_skills_stats_equip_speed_positive">
        <text>\n%c[255,138,43,226]@%c[ui_6] Vitesse de mise en joue/rangement + : %c[d_green]$stat%</text>
    </string>
    <string id="st_skills_stats_equip_speed_negative">
        <text>\n%c[255,138,43,226]@%c[ui_6] Vitesse de mise en joue/rangement - : %c[d_red]$stat%</text>
    </string>

