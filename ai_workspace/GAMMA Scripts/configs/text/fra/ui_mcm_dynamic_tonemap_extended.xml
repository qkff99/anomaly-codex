		<text>Tonemap dynamique</text>
	</string>
	<string id="ui_mcm_dynamic_tonemap_extended_enable_dynamic_tonemap">
		<text>Activer le Dynamic Tonemap</text>
	</string>
	<string id="ui_mcm_dynamic_tonemap_extended_adaptation">
		<text>Adaptation de la carte des tons</text>
	</string>
	<string id="ui_mcm_dynamic_tonemap_extended_k_amount">
		<text>Taux de variation du montant du plan</text>
	</string>
