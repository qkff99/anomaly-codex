  <string id="ui_mcm_menu_cordon_truce">
    <text>Trêve du Cordon</text>
  </string>

  <string id="ui_mcm_cordon_truce_title">
    <text>Options pour la trêve du Cordon</text>
  </string>

  <string id="ui_mcm_cordon_truce_subtitle_warn">
    <text>Options d'avertissement</text>
  </string>

  <string id="ui_mcm_cordon_truce_companionsWarn">
    <text>Avertir aussi les compagnons</text>
  </string>

  <string id="ui_mcm_cordon_truce_companionsWarn_desc">
    <text>Si activé, les compagnons se tiendront aussi à distance des adversaires de la trêve. Sinon, ils les ignoreront jusqu'à la portée de tir.</text>
  </string>

  <string id="ui_mcm_cordon_truce_warnTime">
    <text>Durée d'avertissement</text>
  </string>

  <string id="ui_mcm_cordon_truce_warnTime_desc">
    <text>Durée maximale pendant laquelle les PNJ se font face avant d'ignorer leurs adversaires et de passer à autre chose. Mettre 0 désactive complètement ce comportement pour tout le monde.</text>
  </string>

  <string id="ui_mcm_cordon_truce_ignoreTime">
    <text>Durée d'ignorance</text>
  </string>

  <string id="ui_mcm_cordon_truce_ignoreTime_desc">
    <text>Temps à attendre avant qu'un PNJ ne s'arrête à nouveau devant un autre après avoir quitté un face-à-face.</text>
  </string>

  <string id="ui_mcm_cordon_truce_warnDist">
    <text>Distance d'avertissement</text>
  </string>

  <string id="ui_mcm_cordon_truce_warnDist_desc">
    <text>Distance minimale entre deux PNJ liés par une trêve avant un face-à-face.</text>
  </string>

  <string id="ui_mcm_cordon_truce_attackDist">
    <text>Distance de tir</text>
  </string>

  <string id="ui_mcm_cordon_truce_attackDist_desc">
    <text>Distance minimale entre deux PNJ liés par une trêve avant de tirer.</text>
  </string>

  <string id="ui_mcm_cordon_truce_subtitle_truce">
    <text>Options de trêve</text>
  </string>

  <string id="ui_mcm_cordon_truce_tooCloseSuspends">
    <text>Être trop proche suspend la trêve</text>
  </string>

  <string id="ui_mcm_cordon_truce_tooCloseSuspends_desc">
    <text>Détermine si des tirs liés à la proximité annulent la trêve.</text>
  </string>

  <string id="ui_mcm_cordon_truce_suspendTime">
    <text>Temps de suspension de la trêve</text>
  </string>

  <string id="ui_mcm_cordon_truce_suspendTime_desc">
    <text>Combien de temps la trêve restera suspendue avant d'être rétablie.</text>
  </string>

  <string id="ui_mcm_cordon_truce_time_note">
    <text>REMARQUE : les options sont en secondes de temps de jeu (soit environ 1/6 du temps réel).</text>
  </string>

