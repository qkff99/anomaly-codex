<!-- Button -->
<string id="ui_mcm_ssfx_module_il">
<text>Lumière Indirecte</text>
</string>

<!-- SSR Settings -->
<string id="ui_mcm_ssfx_module_il_title">
<text>Paramètres Lumière Indirecte</text>
</string>

<string id="ui_mcm_ssfx_module_il_quality_mcm">
<text>Qualité</text>
</string>

<string id="ui_mcm_ssfx_module_il_quality_mcm_desc">
<text>[REDÉMARRAGE REQUIS] Nombre d'échantillons utilisés pour le rendu de la lumière indirecte. Les réglages Haut et Très Haut peuvent fortement impacter les performances. [16, 24, 32, 48, 64]</text>
</string>

<string id="ui_mcm_ssfx_module_il_res_mcm">
<text>Résolution</text>
</string>

<string id="ui_mcm_ssfx_module_il_res_mcm_desc">
<text>Résolution du rendu de la lumière indirecte. Valeurs élevées peuvent fortement impacter les performances.</text>
</string>

<string id="ui_mcm_ssfx_module_il_blur_mcm">
<text>Flou</text>
</string>

<string id="ui_mcm_ssfx_module_il_blur_mcm_desc">
<text>Intensité du flou pour lisser le résultat.</text>
</string>

<string id="ui_mcm_ssfx_module_il_vibrance_mcm">
<text>Vibrance des Couleurs</text>
</string>

<string id="ui_mcm_ssfx_module_il_vibrance_mcm_desc">
<text>Définit l'intensité de la couleur de la lumière indirecte.</text>
</string>

<string id="ui_mcm_ssfx_module_il_distance_mcm">
<text>Distance Max</text>
</string>

<string id="ui_mcm_ssfx_module_il_distance_mcm_desc">
<text>Distance maximale de rendu de la lumière indirecte.</text>
</string>

<string id="ui_mcm_ssfx_module_il_global_int_mcm">
<text>Intensité Globale</text>
</string>

<string id="ui_mcm_ssfx_module_il_global_int_mcm_desc">
<text>Intensité de la lumière indirecte pour l'ensemble de la scène. [1.0 = 100% - 0.5 = 50%]</text>
</string>

<string id="ui_mcm_ssfx_module_il_hud_int_mcm">
<text>Intensité HUD</text>
</string>

<string id="ui_mcm_ssfx_module_il_hud_int_mcm_desc">
<text>Intensité pour les éléments HUD (armes, bras, etc.). Pourcentage de l'intensité globale. [1.0 = 100% - 0.5 = 50%]</text>
</string>

<string id="ui_mcm_ssfx_module_il_flora_int_mcm">
<text>Intensité Flore</text>
</string>

<string id="ui_mcm_ssfx_module_il_flora_int_mcm_desc">
<text>Intensité pour la flore (herbes, arbres, etc.). Pourcentage de l'intensité globale. [1.0 = 100% - 0.5 = 50%]</text>
</string>

