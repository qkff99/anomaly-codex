<?xml version="1.0" encoding="windows-1252"?>


<string_table>

	<!-- Bloom Title -->
	<string id="ui_mcm_ssfx_module_motionblur_title">
		<text>Desenfoque de movimiento</text>
	</string>

	<!-- Bloom Settings -->
	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm">
		<text>Calidad</text>
	</string>

	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm_desc">
		<text>Define la cantidad de muestras utilizadas para crear el efecto de desenfoque de movimiento. [ 4 - 6 - 8 - 12 ]</text>
	</string>

	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm">
		<text>Intensidad general</text>
	</string>

	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm_desc">
		<text>Establece la intensidad del efecto de desenfoque de movimiento. Fija el valor a 0 para desactivar el efecto.</text>
	</string>

	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm">
		<text>Intensidad de movimiento de cámara</text>
	</string>

	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm_desc">
		<text>Puedes ajustar la intensidad o desactivar por completo el efecto de desenfoque de movimiento causado por el movimiento de la cámara.</text>
	</string>
	
	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm">
		<text>Solo HUD</text>
	</string>

	<string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm_desc">
		<text>Aplica el efecto de desenfoque de movimiento solamente a elementos del HUD (armas, manos, etc.).</text>
	</string>

</string_table>