<?xml version="1.0" encoding="windows-1251"?>
<string_table>
    <!-- Menu title -->
    <string id="ui_mcm_menu_grenade_trajectory">
        <text>Grenade Trajectory</text>
    </string>
    
    <!-- Enable options -->
    <string id="ui_mcm_grenade_trajectory_enable_grenade">
        <text>Enable for grenades</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_enable_grenade_desc">
        <text>Show trajectory prediction when holding throwable grenades (F1, RGD-5, etc.).</text>
    </string>
    
    <string id="ui_mcm_grenade_trajectory_enable_launcher">
        <text>Enable for launchers</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_enable_launcher_desc">
        <text>Show trajectory prediction when using grenade launchers (GP-25, M203, RG-6, etc.).</text>
    </string>
    
    <!-- LMB show mode -->
    <string id="ui_mcm_grenade_trajectory_lmb_show_mode">
        <text>Normal throw (LMB)</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_lmb_show_mode_desc">
        <text>When to show the normal throw trajectory (constant power).\n \n• Always - Show whenever grenade is equipped\n• Only when LMB held - Show only while holding left mouse button</text>
    </string>
    
    <!-- LMB mode list items -->
    <string id="ui_mcm_lst_gt_lmb_always">
        <text>Always</text>
    </string>
    <string id="ui_mcm_lst_gt_lmb_held">
        <text>Only when LMB held</text>
    </string>
    
    <!-- RMB show toggle -->
    <string id="ui_mcm_grenade_trajectory_rmb_show">
        <text>Charging throw (RMB)</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_rmb_show_desc">
        <text>Show the charging throw trajectory when holding right mouse button.\n \nThe trajectory updates dynamically as throw power increases.</text>
    </string>
    
    <!-- Trajectory dots toggle -->
    <string id="ui_mcm_grenade_trajectory_show_trajectory">
        <text>Show trajectory dots</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_show_trajectory_desc">
        <text>Show the trajectory path as a series of dots.\n \nDisable to show only the impact marker.</text>
    </string>
    
    <!-- Impact marker toggle -->
    <string id="ui_mcm_grenade_trajectory_show_impact">
        <text>Show impact marker</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_show_impact_desc">
        <text>Show a marker at the predicted landing point.\n \nHelps visualize exactly where the grenade will land.</text>
    </string>
    
    <!-- Impact marker size -->
    <string id="ui_mcm_grenade_trajectory_impact_size">
        <text>Impact marker size</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_impact_size_desc">
        <text>Size of the impact marker at the landing point.\n \n1x is the default size. Larger sizes make it easier to see from a distance.</text>
    </string>
    
    <!-- Impact size list items -->
    <string id="ui_mcm_lst_gt_impact_1x">
        <text>1x (default)</text>
    </string>
    <string id="ui_mcm_lst_gt_impact_2x">
        <text>2x</text>
    </string>
    <string id="ui_mcm_lst_gt_impact_3x">
        <text>3x</text>
    </string>
    <string id="ui_mcm_lst_gt_impact_4x">
        <text>4x</text>
    </string>
    <string id="ui_mcm_lst_gt_impact_5x">
        <text>5x</text>
    </string>
    
    <!-- Style selection -->
    <string id="ui_mcm_grenade_trajectory_particle_style">
        <text>Particle style</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_particle_style_desc">
        <text>Visual style of the trajectory particles.\n \n• Glow - Bright, glowing particles with soft edges\n• Solid - Opaque, flat circular markers\n• Dim - Subtle, semi-transparent particles</text>
    </string>
    
    <!-- Style list items -->
    <string id="ui_mcm_lst_gt_style_glow">
        <text>Glow</text>
    </string>
    <string id="ui_mcm_lst_gt_style_solid">
        <text>Solid</text>
    </string>
    <string id="ui_mcm_lst_gt_style_dim">
        <text>Dim</text>
    </string>
    
    <!-- Size selection -->
    <string id="ui_mcm_grenade_trajectory_particle_size">
        <text>Particle size</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_particle_size_desc">
        <text>Size of the trajectory indicator particles.</text>
    </string>
    
    <!-- Size list items -->
    <string id="ui_mcm_lst_gt_size_small">
        <text>Small</text>
    </string>
    <string id="ui_mcm_lst_gt_size_medium">
        <text>Medium</text>
    </string>
    <string id="ui_mcm_lst_gt_size_large">
        <text>Large</text>
    </string>
    
    <!-- Color selection -->
    <string id="ui_mcm_grenade_trajectory_particle_color">
        <text>Trajectory color</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_particle_color_desc">
        <text>Color of the trajectory indicator particles.</text>
    </string>
    
    <!-- Color list items -->
    <string id="ui_mcm_lst_gt_color_green">
        <text>Green</text>
    </string>
    <string id="ui_mcm_lst_gt_color_red">
        <text>Red</text>
    </string>
    <string id="ui_mcm_lst_gt_color_yellow">
        <text>Yellow</text>
    </string>
    <string id="ui_mcm_lst_gt_color_blue">
        <text>Blue</text>
    </string>
    <string id="ui_mcm_lst_gt_color_cyan">
        <text>Cyan</text>
    </string>
    <string id="ui_mcm_lst_gt_color_white">
        <text>White</text>
    </string>
    
    <!-- Brightness options -->
    <string id="ui_mcm_grenade_trajectory_particle_brightness">
        <text>Brightness</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_particle_brightness_desc">
        <text>Brightness level of the trajectory and impact marker.\n \nDark is subtle and less distracting.\nMedium is the default.\nBright is highly visible.</text>
    </string>
    
    <!-- Brightness list items -->
    <string id="ui_mcm_lst_gt_brightness_dark">
        <text>Dark</text>
    </string>
    <string id="ui_mcm_lst_gt_brightness_medium">
        <text>Medium</text>
    </string>
    <string id="ui_mcm_lst_gt_brightness_bright">
        <text>Bright</text>
    </string>
    
    <!-- Trajectory points -->
    <string id="ui_mcm_grenade_trajectory_trajectory_points">
        <text>Trajectory length</text>
    </string>
    <string id="ui_mcm_grenade_trajectory_trajectory_points_desc">
        <text>Number of points along the trajectory.\n \nHigher values = longer prediction distance.</text>
    </string>
</string_table>
