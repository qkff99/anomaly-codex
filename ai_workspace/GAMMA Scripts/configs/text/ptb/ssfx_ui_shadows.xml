	<!-- Shadow Cascades Settings -->
	<string id="ui_mcm_ssfx_module_shadows_title">
		<text>Ajustes de sombra e luz</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_lod_quality_mcm">
		<text>Nivel de detalle de sombras</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_lod_quality_mcm_desc">
		<text>Qualidade básica do mapa de sombras. Quanto maior o valor, maior será a resoluçäo da sombra base e a resoluçäo à distância.</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_lod_min_mcm">
		<text>Resolución mínima de sombras</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_lod_min_mcm_desc">
		<text>Resoluçäo mínima do mapa de sombras. Quando as luzes estäo longe do player, a resoluçäo das sombras diminui para melhorar o desempenho (em detrimento da qualidade da imagem).</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_lod_max_mcm">
		<text>Resolución máxima de sombras</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_lod_max_mcm_desc">
		<text>Resoluçäo máxima do mapa de sombras. Quando as luzes estäo mais próximas, a resoluçäo aumenta para melhorar a qualidade da imagem das sombras (à custa do desempenho).</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_volumetric_force_mcm">
		<text>Forzar sombras volumétricas (recarga de mapa obligatoria)</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_volumetric_force_mcm_desc">
		<text>Força o efeito volumétrico em todas as luzes näo direcionais. O mapa precisa ser recarregado para aplicar o ajuste.</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_volumetric_int_mcm">
		<text>Intensidade volumétrica</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_volumetric_int_mcm_desc">
		<text>Define a intensidade do efeito volumétrico.</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_volumetric_quality_mcm">
		<text>Qualidade volumétrica</text>
	</string>

	<string id="ui_mcm_ssfx_module_shadows_volumetric_quality_mcm_desc">
		<text>Estabelece a qualidade do efeito volumétrico em detrimento do desempenho.</text>
	</string>



