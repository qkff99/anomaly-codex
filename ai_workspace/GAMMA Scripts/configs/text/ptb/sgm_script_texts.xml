       <string id="lesnik_21_point_dialog_1">
		<text>Vovö, queria te perguntar uma coisa.</text>
	</string>
        <string id="lesnik_21_point_dialog_2">
		<text>Do que se trata, calvo, o que vocë quer?</text>
	</string>
