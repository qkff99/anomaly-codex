<string id="zat_sich_minigame_21_point_dialog_1">
		<text>Ei, eu queria te perguntar uma coisa.</text>
	</string>
        <string id="sich_minigame_21_point_dialog_2">
		<text>Sim? Qual é a sua pergunta?</text>
	</string>
