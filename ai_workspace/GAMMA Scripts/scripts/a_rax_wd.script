Watch Dog timers to detect hangs in the the actor update callback and timed event queue the 2 major causes of the "Busy Hands" bug in anomaly.
--]]







local crash_on_error = true -- setting to false will not crash the game on first error. allowing you to keep playing, not a good idea.
local crash_on_all = false -- setting to true will crash on all detections not just the major hangs
local hang_time = 0.5 --time in seconds callback/event system is allowed to hang
local lag_protection = 5 --time is seconds to not check for hangs around save or inventory opening to avoid false positives. 



local watch_list = {--actor and global callbacks set to false, set to true for NPC and mutant callbacks or any callback that can be sent from multiple sources. don't use for dxml callbacks 
	actor_on_update = false,
	actor_on_first_update = false,
	--npc_on_update = true,
}


local registred_callbacks = {}
local running_callbacks = {}


base_calback_set = axr_main.callback_set
function axr_main.callback_set(name,func_or_userdata)
	if not (watch_list[name] ~= nil) then
		base_calback_set(name,func_or_userdata)
	else --only register it here if it is one of ours
		if (func_or_userdata == nil) then 
			-- printf("![axr_main callback_set] trying to set callback %s to nil function!",name)
			callstack()
			return
		end
		running_callbacks[name] = running_callbacks[name] or {}
		registred_callbacks[name] = registred_callbacks[name] or {}
		registred_callbacks[name][func_or_userdata] = true
	end
end
base_callback_unset = axr_main.callback_unset
function axr_main.callback_unset(name,func_or_userdata)
	if (watch_list[name] ~= nil) then
		registred_callbacks[name][func_or_userdata] = nil
	end
	base_callback_unset(name,func_or_userdata) --unregister in both just in case someting snuck thru
end

base_make_callback = axr_main.make_callback
function axr_main.make_callback(name,...)
	if (watch_list[name] ~= nil) then
		make_callback_watcher(name,...)
	end
	base_make_callback(name,...)--send in both just in case someting snuck thru
	
end



function make_callback_watcher(name,...)
	local g_type = type
	if (registred_callbacks[name]) then
		local npc_id = false
		if watch_list[name]  then
			local t = {...}
			if not t[1] or g_type(t[1]) ~= "userdata" then
				npc_id = "error no npc/mutant id"
			elseif g_type(t[1].id) == "function" then
				npc_id = {t[1]:id(), t[1]:section()}
			elseif g_type(t[1].id) == "number" then
				npc_id = {t[1].id, t[1].section_name and t[1]:section_name()}
			end
		end
		for func_or_userdata,v in pairs(registred_callbacks[name]) do 
			if (g_type(func_or_userdata) == "function" ) then 
				running_callbacks[name][npc_id] = {tmr = time_global() + hang_time * 1000, func = func_or_userdata}
				func_or_userdata(...)
				running_callbacks[name][npc_id] = nil
			elseif (func_or_userdata[name] ) then
				running_callbacks[name][npc_id] = {tmr = time_global() + hang_time * 1000, func = func_or_userdata[name]}
				func_or_userdata[name](func_or_userdata,...)
				running_callbacks[name][npc_id] = nil
			end
		end
	else
		-- printf("! [RAX WD] can't make callback to non existing intercept %s! how did we get here?!?!?",name)
		callstack()
	end
end




