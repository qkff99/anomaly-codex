local DEFAULT_TOGGLE_KEY = (DIK_keys and DIK_keys.DIK_G) or 34
local DEFAULT_UI_TOGGLE_KEY = (DIK_keys and DIK_keys.DIK_H) or 36
local DEFAULT_FREE_LOOK_KEY = (DIK_keys and DIK_keys.DIK_LMENU) or 56
local DEFAULT_ENABLED = true
local DEFAULT_FOLLOW_ACTOR = true
local DEFAULT_HIDE_HEAD_IN_POV = true
local DEFAULT_DEATH_CAM = true
local DEFAULT_DEATH_AUTO_SWITCH = true
local DEFAULT_DEATH_AUTO_SWITCH_MODE = "auto"
local DEFAULT_POV_FOV = 100.0
local DEFAULT_CAMERA_UPDATE_HZ = 60.0
local DEFAULT_CAMERA_EMA_STRENGTH = 0.80
local DEFAULT_CAMERA_LAG_COMPENSATION = 1.0
local DEFAULT_BANNER_LINK = "AMCM_Banner.dds"
local CUSTOM_BANNER_LINK = "ui\\gopro_mod\\gopro_mod_mcm_banner.dds"

local function get_banner_link()
	local fs = getFS and getFS()
	if fs and fs.exist and fs:exist("$game_textures$", CUSTOM_BANNER_LINK) ~= nil then
		return CUSTOM_BANNER_LINK
	end

	return DEFAULT_BANNER_LINK
end

function on_mcm_load()
	return {
		id = "gopro_mod",
		sh = true,
		text = "ui_mcm_menu_gopro_mod",
