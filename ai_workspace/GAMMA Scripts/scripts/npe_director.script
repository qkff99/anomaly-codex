-------------------------------------------------- NPE Data Structures --------------------------------------------------

-- this queue is populated at startup from other npe modules when available otherwise it will only have the npe tutorial module
local npeConfig = {
    decks = {},
}

local npe_state = nil

function get_state()
    local npe_state = {}
    for deckId, deck in pairs(npeConfig.decks) do
        if not npe_state[deckId] then
            npe_state[deckId] = {}
        end
        for setId, set in pairs(deck.sets) do
            if not npe_state[deckId][setId] then
                npe_state[deckId][setId] = {}
            end
            npe_state[deckId][setId]["played"] = set.played
        end
    end
    return npe_state
end

function apply_state(npe_state)
    if not npe_state then 
        return
    end
    for deckId, deck in pairs(npeConfig.decks) do
        if npe_state[deckId] then
            for setId, set in pairs(deck.sets) do
                if npe_state[deckId][setId] then
                    Update_set_played_state(set, npe_state[deckId][setId].played)
                end
            end
        end
    end
    npe_state = nil
end

-- this queue is populated at first actor update and when the MCM settings are changed
