local function log_message(message)
	log(string_format("%s %s", MOD_LABEL, message))
end

local function clamp_number(value, minimum, maximum)
	if value < minimum then
		return minimum
	end

	if value > maximum then
		return maximum
	end

	return value
end

local function round_to(value, precision)
	local multiplier = 10 ^ (precision or 0)

	if value >= 0 then
		return math_floor((value * multiplier) + 0.5) / multiplier
	end

	return -math_floor((-value * multiplier) + 0.5) / multiplier
end

local function format_number(value, precision)
	return string_format("%." .. tostring(precision or 0) .. "f", value)
end

