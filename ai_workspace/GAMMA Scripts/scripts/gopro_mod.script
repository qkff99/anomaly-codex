local function clone_vector(source)
	local result

	if not source then
		return nil
	end

	result = vector()
	result:set(source)
	return result
end

local function get_now_ms()
	return time_global and time_global() or 0
end

local function wrap_angle(value)
	while value > math_pi do
		value = value - TWO_PI
	end

	while value < -math_pi do
		value = value + TWO_PI
	end

	return value
end

local function coerce_boolean(value, default_value)
	local value_type = type(value)

	if value_type == "boolean" then
		return value
	end

	if value_type == "number" then
		return value ~= 0
	end

	if value_type == "string" then
		value = string_lower(value)

		if value == "true" or value == "1" or value == "yes" then
			return true
		end

		if value == "false" or value == "0" or value == "no" then
			return false
		end
	end

	return default_value and true or false
end

local function translate(id, fallback)
	local text = game and game.translate_string and game.translate_string(id) or id

	if text == id then
		return fallback or id
	end

	return text
end

local function display_key_name(dik)
	local lang
	local text

	if dik == nil then
		return "?"
	end

	if INI_LOC and INI_MCM_KEY then
		lang = INI_LOC:r_value("string_table", "language")
		lang = INI_MCM_KEY:section_exist(lang) and lang or "eng"
		text = INI_MCM_KEY:r_value(lang, dik, 0, nil)

		if text and text ~= "" then
			return text
		end
	end

	return tostring(dik)
end

